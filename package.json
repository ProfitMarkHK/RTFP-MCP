{
  "name": "rtfp-mcp",
  "version": "0.1.0",
  "description": "MCP server for the GFO-X RTFP market data API - live BTC futures, options, greeks, orderbook and statistics via any MCP client",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gfo-x",
    "rtfp",
    "market-data",
    "bitcoin",
    "derivatives",
    "futures",
    "options"
  ],
  "author": "Barry Gausden",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rtfp-mcp": "dist/index.js"
  },
  "files": [
    "dist/**/*",
    "src/**/*",
    "README.md",
    "AGENTS.md",
    "docs/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "start": "bun run dist/index.js",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "test:live": "RTFP_LIVE=1 bun test tests/live.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests scripts examples",
    "complexity": "eslint src",
    "smoke": "bun run examples/smoke-client.ts",
    "check": "bash scripts/check-gates.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "^1.4.5",
    "eslint": "^10.15.0",
    "oxlint": "^1.93.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.73.0"
  }
}
